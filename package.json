{
  "name": "vidzilla",
  "version": "1.0.3",
  "private": true,
  "description": "Personal Chrome extension that finds and downloads video and audio from web pages.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "site": "node scripts/build-site.mjs",
    "site:serve": "node scripts/build-site.mjs && node scripts/serve-site.mjs",
    "og": "node scripts/make-og.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "pnpm build && node --test tests/e2e/*.test.mjs",
    "fixtures": "bash tests/fixtures/make-fixtures.sh",
    "package": "pnpm build && node scripts/package.mjs",
    "store-assets": "pnpm build && node scripts/store-assets.mjs"
  },
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@types/chrome": "^0.3.6",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "3.10.4",
    "mediabunny": "1.62.1"
  },
  "engines": {
    "node": ">=22.12"
  }
}
