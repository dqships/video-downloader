{
  "manifest_version": 3,
  "name": "Vidzilla",
  "short_name": "Vidzilla",
  "version": "1.0.2",
  "description": "Finds the video and audio a page plays and saves it to your computer.",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabs",
    "offscreen",
    "downloads",
    "webRequest",
    "webNavigation",
    "scripting",
    "declarativeNetRequest",
    "sidePanel",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "eme-main.js",
        "mse-main.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "eme-bridge.js",
        "mse-bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Vidzilla",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "brand/icon-16.png",
      "32": "brand/icon-32.png"
    }
  },
  "icons": {
    "16": "brand/icon-16.png",
    "32": "brand/icon-32.png",
    "48": "brand/icon-48.png",
    "128": "brand/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "capture.html",
        "capture.js"
      ],
      "matches": [
        "<all_urls>"
      ],
      "use_dynamic_url": true
    }
  ]
}
