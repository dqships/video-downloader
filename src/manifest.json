{
  "manifest_version": 3,
  "name": "Vidzilla",
  "short_name": "Vidzilla",
  "version": "0.1.0",
  "description": "Finds the video and audio a page plays and saves it to your computer.",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabs",
    "offscreen",
    "downloads",
    "webRequest",
    "webNavigation",
    "scripting",
    "declarativeNetRequest",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "action": {
    "default_title": "Vidzilla",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
